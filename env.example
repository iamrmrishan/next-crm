# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Required: Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Required: Your Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for enhanced permissions during migration
# This key has elevated permissions and should be kept secure
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: The service role key is optional but recommended for migration scripts
# as it provides the necessary permissions for batch operations and RLS bypass